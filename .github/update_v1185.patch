+const SHARE_FONT_FAMILIES={
+  original:'"Noto Serif TC","PingFang TC","Microsoft JhengHei",sans-serif',
+  ming:'"Noto Serif TC","PMingLiU","Songti TC",serif',
+  sans:'"PingFang TC","Microsoft JhengHei","Noto Sans TC","Arial",sans-serif',
+  kai:'"BiauKai","DFKai-SB","KaiTi","STKaiti",serif'
+};
+
+function defaultShareFontSize(format){
+  return format==="square" ? 44 : 52;
+}
+
+function shareStyleField(format,type){
+  const prefix=format==="square"?"share_square":"share_story";
+  return `${prefix}_${type}`;
+}
+
+function shareFontKey(format){
+  const value=currentStory?.[shareStyleField(format,"font_key")];
+  return Object.prototype.hasOwnProperty.call(SHARE_FONT_FAMILIES,value)
+    ? value
+    : "original";
+}
+
+function shareFontFamily(format){
+  return SHARE_FONT_FAMILIES[shareFontKey(format)]||SHARE_FONT_FAMILIES.original;
+}
+
 function shareFontSize(format){
-  // 長文不再一路縮字；維持手機可讀尺寸，放不下就換頁。
-  return format==="square" ? 44 : 52;
-}
+  // 預設完全沿用原版；只有這一篇有自訂值時才覆蓋。
+  const raw=Number(currentStory?.[shareStyleField(format,"font_size")]);
+  if(Number.isFinite(raw) && raw>=28 && raw<=84)return Math.round(raw);
+  return defaultShareFontSize(format);
+}
+
+function shareBodyCanvasFont(format,fontSize=shareFontSize(format)){
+  return `700 ${fontSize}px ${shareFontFamily(format)}`;
+}
+
+function isOriginalShareTextStyle(format){
+  return shareFontKey(format)==="original"
+    && shareFontSize(format)===defaultShareFontSize(format);
+}
+
+function syncShareTextStyleControls(){
+  if(!currentStory)return;
+  const fontKey=shareFontKey(currentShareFormat);
+  const fontSize=shareFontSize(currentShareFormat);
+  $("#shareFontSelect").value=fontKey;
+  $("#shareFontSizeRange").value=String(fontSize);
+  $("#shareFontSizeValue").textContent=`${fontSize} px${fontSize===defaultShareFontSize(currentShareFormat)?" · 原版":""}`;
+  $("#shareTextFormatLabel").textContent=currentShareFormat==="square"?"貼文版":"限動版";
+  $("#shareTextStyleStatus").textContent=isOriginalShareTextStyle(currentShareFormat)
+    ?"目前使用原版設定。"
+    :"已自訂這一篇；切換其他投稿不會跟著改。";
+}
+
+let shareTextStyleSaveTimer=null;
+
+async function saveCurrentShareTextStyle(){
+  if(!currentStory)return;
+  const payload={
+    share_story_font_key:currentStory.share_story_font_key??null,
+    share_story_font_size:currentStory.share_story_font_size??null,
+    share_square_font_key:currentStory.share_square_font_key??null,
+    share_square_font_size:currentStory.share_square_font_size??null
+  };
+  const {error}=await supabase.from("messages").update(payload).eq("id",currentStory.id);
+  if(error){
+    console.error("save_share_text_style_failed",error);
+    $("#shareTextStyleStatus").textContent="文字樣式儲存失敗，請稍後再試。";
+    return false;
+  }
+  $("#shareTextStyleStatus").textContent=isOriginalShareTextStyle(currentShareFormat)
+    ?"已恢復原版設定。"
+    :"這一篇的文字樣式已儲存。";
+  return true;
+}
+
+function queueShareTextStyleSave(){
+  clearTimeout(shareTextStyleSaveTimer);
+  shareTextStyleSaveTimer=setTimeout(()=>saveCurrentShareTextStyle(),420);
+}
+
+async function refreshShareTextStylePreview({prepareApple=false}={}){
+  if(!currentStory)return;
+  currentSharePage=0;
+  invalidateAppleShareCache();
+  prepareSharePages(currentStory.content,currentShareFormat);
+  syncShareTextStyleControls();
+  syncShareFormatUI();
+  await drawShareImage(currentStory.content,currentShareFormat,currentSharePage);
+  if(prepareApple)prepareAppleShareFiles();
+}
+
+$("#shareFontSelect").addEventListener("change",async()=>{
+  if(!currentStory)return;
+  currentStory[shareStyleField(currentShareFormat,"font_key")]=$("#shareFontSelect").value;
+  await refreshShareTextStylePreview();
+  await saveCurrentShareTextStyle();
+  prepareAppleShareFiles();
+});
+
+$("#shareFontSizeRange").addEventListener("input",async()=>{
+  if(!currentStory)return;
+  const size=Math.max(28,Math.min(84,Number($("#shareFontSizeRange").value)||defaultShareFontSize(currentShareFormat)));
+  currentStory[shareStyleField(currentShareFormat,"font_size")]=size;
+  await refreshShareTextStylePreview();
+  queueShareTextStyleSave();
+});
+
+$("#shareFontSizeRange").addEventListener("change",async()=>{
+  if(!currentStory)return;
+  clearTimeout(shareTextStyleSaveTimer);
